# Used by `npm run blog:import` (scripts/import-instagram.ts). Copy to .env.

# Anthropic API key. Not needed if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Long-lived Instagram access token for the @daysofmilan account
# (Instagram API with Instagram Login, permission instagram_business_basic).
# Not needed if you pass --images <folder>.
IG_ACCESS_TOKEN=
